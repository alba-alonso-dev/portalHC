# ──────────────────────────────────────────────────────────────────────────
# .env.example — copia este archivo a `.env` y ajusta los valores.
#
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env      (Windows CMD)
#   Copy-Item .env.example .env (Windows PowerShell)
#
# Docker Compose lee automáticamente el archivo .env de la misma carpeta.
# ──────────────────────────────────────────────────────────────────────────

# Puerto de la app en tu máquina (HOST). El contenedor siempre escucha en 5000
# internamente; esto mapea el puerto del host al del contenedor.
HOST_PORT=5000

# Modo debug de Flask. En producción: false.
FLASK_DEBUG=false

# Número de workers de gunicorn. 2 es suficiente para uso interno de equipo.
# Subir a 4 si hay más concurrencia, pero ojo con SQLite (single-writer).
GUNICORN_WORKERS=2

# ── Permisos ──────────────────────────────────────────────────────────────
# Permitir crear/editar/borrar datos maestros (países, sedes, sociedades...)
# desde la pestaña Admin. En demo/producción: false.
ALLOW_ADMIN_MAESTROS=false

# Permitir reset de datos (POST /api/dev/reset-datos). SOLO desarrollo.
# En cualquier entorno compartido: false.
ALLOW_DEV_RESET=false

# ── Backend de almacenamiento de documentos ──────────────────────────────
# local  → PDFs en disco (/data/uploads dentro del contenedor).
# sharepoint → esqueleto no implementado (lanza NotImplementedError).
DOCUMENTO_STORAGE=local
